# Milestone 13: writes bound_build_info.h, naming the git commit being built, so that --version says
# exactly which source a program came from. It runs at every build but rewrites the header only when
# the commit changes, so an unchanged tree recompiles nothing.
#   cmake -DSOURCE_DIR=<the repository> -DOUTPUT=<the header> -P build_info.cmake
set(commit "")
find_program(GIT_EXECUTABLE git)
if(GIT_EXECUTABLE AND EXISTS "${SOURCE_DIR}/.git")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=12 HEAD
                  OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
  if(failed)
    set(commit "")  # not a checkout git trusts (another user's files, say): leave it out
  else()
    # Tracked files changed since that commit? Then this isn't exactly that commit.
    execute_process(COMMAND "${GIT_EXECUTABLE}" --no-optional-locks -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE changes ERROR_QUIET)
    if(NOT changes STREQUAL "")
      string(APPEND commit "-dirty")
    endif()
  endif()
endif()

set(content "// Generated by cmake/build_info.cmake at build time.\n#define BOUND_BUILD_COMMIT \"${commit}\"\n")
set(old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
